<%- include("partials/head", {
  title: "Sweet Corn Cast — Harvest Forecast | Tui Farms, Manheim PA",
  description: "When will fresh sweet corn be ready? Tui Farms' harvest forecast for Manheim, Lancaster County PA — updated from real field conditions. Text 717-803-1649 to order."
}) %>
<%- include("partials/nav") %>
<%- include("partials/page-title", {
  heading: "🌽 The Corn Cast",
  subheading: "Our sweet corn harvest forecast — computed from planting dates, real weather, and daily field checks"
}) %>

<section class="page-section">

  <p style="margin:0 0 1em;">
    <a href="/produce" style="color:var(--accent); font-weight:600;">← Back to produce</a>
  </p>

  <!-- Season strip -->
  <div class="availability-strip" style="margin-bottom:2em;">
    <strong style="color:var(--primary);">This season at a glance</strong>
    <p style="margin:0.5em 0 0;">
      <% if (seasonLine) { %>
        <%= seasonLine %>
      <% } else if (product && product.statusNote) { %>
        <%= product.statusNote %>
      <% } else { %>
        Text <strong>717-803-1649</strong> for today's corn availability.
      <% } %>
    </p>
  </div>

  <!-- Variety calendar -->
  <% if (calendar) { %>
    <div class="card" style="margin-bottom:2em;">
      <h3 style="color:var(--primary); margin-top:0;">The season by variety</h3>
      <p class="muted" style="margin-top:0;">
        Loved the corn from a particular week? Find its variety here — most return next year.
      </p>

      <div class="cal-scroll">
        <div class="cal">
          <div class="cal-lines" aria-hidden="true">
            <% calendar.axis.months.forEach(m => { %>
              <% if (!m.partial) { %>
                <div class="cal-grid" style="left:<%= m.pct.toFixed(2) %>%;"></div>
              <% } %>
            <% }) %>
            <% if (calendar.axis.today) { %>
              <div class="cal-today" style="left:<%= calendar.axis.today.pct.toFixed(2) %>%;">
                <span><%= calendar.axis.today.label %></span>
              </div>
            <% } %>
            <% if (calendar.axis.frost) { %>
              <div class="cal-frostline" style="left:<%= calendar.axis.frost.pct.toFixed(2) %>%;">
                <span><%= calendar.axis.frost.label %></span>
              </div>
            <% } %>
          </div>

          <div class="cal-rows">
            <% if (calendar.frostRisk) { const fr = calendar.frostRisk; %>
              <div class="cal-row cal-risk-row">
                <div class="cal-label">❄ Frost risk</div>
                <div class="cal-track">
                  <button type="button"
                    class="cal-risk<%= openId === 'frost-risk' ? ' is-open' : '' %>"
                    id="bar-frost-risk" data-pop="pop-frost-risk"
                    aria-controls="pop-frost-risk" aria-expanded="<%= openId === 'frost-risk' %>"
                    aria-label="Frost risk — the chance a frost has hit by each date; details"
                    style="left:<%= fr.leftPct.toFixed(2) %>%; width:<%= fr.widthPct.toFixed(2) %>%; background:<%= fr.gradient %>;">
                    <% fr.ticks.forEach(t => { %>
                      <span class="cal-risk-tick<%= t.dark ? ' on-light' : '' %><%= t.end ? ' at-end' : '' %>"<%- t.end ? '' : ' style="left:' + t.pct.toFixed(1) + '%;"' %>><%= t.label %></span>
                    <% }) %>
                  </button>
                </div>
              </div>
            <% } %>
            <% calendar.lanes.forEach(lane => { %>
              <div class="cal-row">
                <div class="cal-label"><%= lane.variety %></div>
                <div class="cal-track">
                  <% lane.segments.forEach(seg => { %>
                    <button type="button"
                      class="cal-bar<%= seg.frostCapped ? ' frost-capped' : '' %><%= openId === seg.id ? ' is-open' : '' %>"
                      id="bar-<%= seg.id %>" data-pop="pop-<%= seg.id %>"
                      aria-controls="pop-<%= seg.id %>" aria-expanded="<%= openId === seg.id %>"
                      <% if (seg.frostRace) { %>
                        aria-label="<%= lane.variety %> — racing the frost, first pick <%= seg.startLabel %> at best; details"
                      <% } else { %>
                        aria-label="<%= lane.variety %> — available <%= seg.startLabel %> to <%= seg.endLabel %>; details"
                      <% } %>
                      style="left:<%= seg.leftPct.toFixed(2) %>%; width:<%= seg.widthPct.toFixed(2) %>%; --hue:<%= lane.color %>; --tint:<%= lane.tint %>; --border-c:<%= lane.border %>;">
                      <span class="cal-bar-past" style="width:<%= seg.pastPct.toFixed(1) %>%;"></span>
                    </button>
                  <% }) %>
                </div>
              </div>
            <% }) %>
            <div class="cal-row cal-axis-row" aria-hidden="true">
              <div class="cal-label"></div>
              <div class="cal-track cal-axis">
                <% calendar.axis.months.forEach(m => { %>
                  <span class="cal-month<%= m.partial ? ' partial' : '' %>" style="left:<%= m.pct.toFixed(2) %>%;"><%= m.label %></span>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Small screens: the calendar is wider than the viewport and scrolls
           sideways. The script below opens it on today and turns these
           controls on only when the calendar actually overflows. -->
      <div class="cal-nav" role="group" aria-label="Scroll the calendar">
        <button type="button" data-cal-nav="back">‹ Earlier</button>
        <button type="button" data-cal-nav="today">Today</button>
        <button type="button" data-cal-nav="fwd">Later ›</button>
      </div>

      <!-- Popover panels (server-rendered, toggled by the script below;
           ?open=<segmentId> renders one open without JavaScript) -->
      <div class="cal-pops">
        <% if (calendar.frostRisk) { %>
          <div class="cal-pop" id="pop-frost-risk" role="region" aria-label="Frost risk details"
               style="--hue:#2b4b6b;" <%- openId === 'frost-risk' ? '' : 'hidden' %>>
            <p style="margin:0 0 0.4em;">
              <strong>❄ Frost risk</strong> — the chance a frost has hit by a given date
            </p>
            <% calendar.frostRisk.lines.forEach(line => { %>
              <p class="muted" style="margin:0 0 0.4em;"><%= line %></p>
            <% }) %>
            <p class="muted" style="margin:0;">
              A hard frost ends the corn season — whatever is still standing then is lost.
            </p>
          </div>
        <% } %>
        <% calendar.lanes.forEach(lane => { lane.segments.forEach(seg => { %>
          <div class="cal-pop" id="pop-<%= seg.id %>" role="region"
               aria-label="<%= lane.variety %> details"
               style="--hue:<%= lane.border %>;" <%- openId === seg.id ? '' : 'hidden' %>>
            <p style="margin:0 0 0.4em;">
              <strong><%= lane.variety %></strong>
              <% if (seg.frostRace) { %>
                — racing the frost
              <% } else { %>
                — available <%= seg.startLabel %> to <%= seg.endLabel %>
              <% } %>
            </p>
            <% if (seg.frostRace) { %>
              <p class="muted" style="margin:0 0 0.5em;">
                This late corn is racing the fall frost. <%= seg.raceNote %>
                No promises either way — we'll know when the weather does.
              </p>
            <% } else if (seg.frostCapped) { %>
              <p class="muted" style="margin:0 0 0.5em;">
                The tail of this window is weather permitting — frost ends the season.
              </p>
            <% } %>
            <% if (seg.doneSummary) { %>
              <p class="muted" style="margin:0 0 0.4em;"><%= seg.doneSummary %></p>
            <% } %>
            <% seg.plantings.forEach(p => { %>
              <div class="cal-pop-planting">
                <strong><%= p.name %></strong>
                <% if (p.status === 'picking') { %>
                  <span class="chip in-season">Picking now</span>
                <% } else { %>
                  <span class="chip coming">Coming</span>
                <% } %>
                <% if (p.limitedSupply) { %>
                  <span class="chip coming">Limited supply — text ahead</span>
                <% } %>
                <% if (p.windows) { %>
                  <ul class="cal-pop-windows">
                    <% p.windows.forEach(w => { %>
                      <li><strong><%= w.label %>:</strong> <%= w.dates %></li>
                    <% }) %>
                  </ul>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% }) }) %>
      </div>

      <p class="muted" style="font-size:0.9em; margin-bottom:0;">
        Solid color is picked or on track; the lighter shade is forecast, and a
        bar that fades out has no promised end. Dates with a ~ are estimates and
        can shift a few days as real weather comes in — we update this page from
        actual field checks. The top bar is the frost risk: the chance a frost
        has hit by each date. Tap any bar for details.
      </p>
    </div>
  <% } else if (!seasonLine) { %>
    <div class="card" style="text-align:center; margin-bottom:2em;">
      <p>The forecast is taking a breather — text <strong>717-803-1649</strong> for
         today's corn availability.</p>
    </div>
  <% } %>

  <!-- Pricing -->
  <% if (product && product.pricing && product.pricing.length > 0) { %>
    <div class="card" style="margin:2em 0;">
      <h3 style="color:var(--primary); margin-top:0;">Sweet corn pricing</h3>
      <table class="pricing-table">
        <% product.pricing.forEach(row => { %>
          <tr>
            <td><%= row.label %></td>
            <td><%= row.price %></td>
          </tr>
        <% }) %>
      </table>
    </div>
  <% } %>

  <%- include("partials/order-info") %>
</section>

<style>
  /* ---- variety calendar (only this page uses it) ---- */
  .cal-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .cal { min-width: 560px; position: relative; padding-top: 20px; }
  /* Phones: a wider timeline so a few weeks fill the screen legibly. The
     script scrolls it to today; the label column stays put (sticky). */
  @media (max-width: 600px) {
    .cal { min-width: 640px; }
  }

  /* rows: fixed label column + flexible track */
  .cal-row { display: flex; align-items: center; }
  .cal-label {
    flex: 0 0 84px;
    position: sticky;
    left: 0;
    z-index: 2;
    background: var(--card-bg, #fff);
    font-size: 0.9em;
    font-weight: 600;
    padding-right: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* once scrolled, the label column reads as a shelf the bars slide under */
  .cal-scrolled .cal-label { box-shadow: 6px 0 8px -6px rgba(0,0,0,0.25); }
  .cal-track { flex: 1; position: relative; height: 30px; }

  /* Earlier / Today / Later — shown by the script only when scrollable */
  .cal-nav { display: none; justify-content: center; gap: 0.5em; margin-top: 0.8em; }
  .cal-nav.is-on { display: flex; }
  .cal-nav button {
    appearance: none;
    -webkit-appearance: none;
    background: var(--card-bg, #fff);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35em 0.9em;
    font: inherit;
    font-size: 0.9em;
    font-weight: 600;
    color: var(--primary);
    cursor: pointer;
  }
  .cal-nav button[data-cal-nav="today"] { color: #d9480f; border-color: #d9480f; }
  .cal-nav button[hidden] { display: none; }
  .cal-nav button:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .cal-axis-row .cal-track { height: 22px; }
  .cal-risk-row { margin-bottom: 6px; }

  /* gridlines + today + frost lines overlay the track column only */
  .cal-lines {
    position: absolute;
    left: 84px; right: 0;
    top: 0; bottom: 22px;
    pointer-events: none;
  }
  .cal-lines > div { position: absolute; top: 20px; bottom: 0; width: 0; }
  .cal-grid { border-left: 1px solid var(--border); opacity: 0.55; }
  .cal-today { border-left: 2px solid #d9480f; }
  .cal-today span, .cal-frostline span {
    position: absolute;
    top: -20px;
    font-size: 0.72em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .cal-today span { color: #d9480f; left: 50%; transform: translateX(-50%); }
  .cal-frostline { border-left: 2px dashed var(--muted); }
  .cal-frostline span { color: var(--muted); right: 3px; }

  .cal-month {
    position: absolute;
    top: 4px;
    transform: translateX(-50%);
    font-size: 0.78em;
    color: var(--muted);
  }
  /* partial leading month sits flush with the axis's left edge */
  .cal-month.partial { transform: none; }

  /* availability bars */
  .cal-bar, .cal-risk {
    position: absolute;
    top: 5px;
    height: 20px;
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    border-radius: 4px;
    /* 2px card-colored halo = the white gap wherever two segments abut */
    box-shadow: 0 0 0 2px var(--card-bg, #fff);
  }
  .cal-bar {
    background: var(--tint);
    border: 1px solid var(--border-c);
    overflow: hidden;
  }
  .cal-bar-past {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    background: var(--hue);
    border-radius: 3px 0 0 3px;
  }
  .cal-bar.frost-capped {
    -webkit-mask-image: linear-gradient(to right, #000 72%, transparent 100%);
    mask-image: linear-gradient(to right, #000 72%, transparent 100%);
  }
  /* frost-risk bar: gradient background set inline; percent marks ride on it */
  .cal-risk {
    border: 1px solid rgba(43, 75, 107, 0.4);
    overflow: hidden;
    font: inherit;
  }
  .cal-risk-tick {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 0.68em;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fff;
    white-space: nowrap;
    pointer-events: none;
  }
  .cal-risk-tick.on-light { color: #2b4b6b; }
  .cal-risk-tick.at-end { left: auto; right: 4px; transform: translateY(-50%); }
  .cal-bar:focus-visible, .cal-risk:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .cal-bar.is-open, .cal-risk.is-open {
    outline: 2px solid var(--primary);
    outline-offset: 1px;
  }

  /* popover panels — normal text ink; the hue appears only as an edge strip */
  .cal-pop {
    border: 1px solid var(--border);
    border-left: 4px solid var(--hue);
    border-radius: 8px;
    background: var(--card-bg, #fff);
    padding: 0.8em 1em;
    margin-top: 0.9em;
  }
  .cal-pop-planting { margin: 0.5em 0 0; }
  .cal-pop-windows {
    list-style: none;
    padding: 0 0 0 0.2em;
    margin: 0.25em 0 0;
    font-size: 0.92em;
    line-height: 1.7;
  }
</style>

<script>
  // Popover toggling — tap/click is the primary path; hover also opens on
  // devices that hover; Escape or an outside tap dismisses. No dependencies.
  (function () {
    var bars = Array.prototype.slice.call(document.querySelectorAll('[data-pop]'));
    var open = null;          // the bar whose popover is showing
    var openedByHover = false;

    function panelOf(bar) { return document.getElementById(bar.getAttribute('data-pop')); }
    function close() {
      if (!open) return;
      panelOf(open).hidden = true;
      open.setAttribute('aria-expanded', 'false');
      open.classList.remove('is-open');
      open = null;
    }
    function show(bar, byHover) {
      if (open === bar) return;
      close();
      panelOf(bar).hidden = false;
      bar.setAttribute('aria-expanded', 'true');
      bar.classList.add('is-open');
      open = bar;
      openedByHover = byHover;
    }

    bars.forEach(function (bar) {
      bar.addEventListener('click', function (e) {
        e.stopPropagation();
        if (open === bar && !openedByHover) { close(); }
        else { show(bar, false); openedByHover = false; }
      });
      bar.addEventListener('mouseenter', function () {
        if (window.matchMedia('(hover: hover)').matches && (!open || openedByHover)) show(bar, true);
      });
      bar.addEventListener('mouseleave', function () {
        if (openedByHover && open === bar) close();
      });
    });
    document.addEventListener('click', function (e) {
      if (open && !e.target.closest('.cal-pop')) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });

    // Adopt a server-rendered open panel (?open=<segmentId>).
    var pre = document.querySelector('.cal-pop:not([hidden])');
    if (pre) {
      var preBar = document.querySelector('[data-pop="' + pre.id + '"]');
      if (preBar) { open = preBar; openedByHover = false; }
    }
  })();

  // Small screens: the calendar overflows and scrolls sideways. Open it on
  // today — a little history on the left, more of what's coming on the
  // right — and show Earlier / Today / Later only when it actually overflows.
  (function () {
    var scroller = document.querySelector('.cal-scroll');
    var nav = document.querySelector('.cal-nav');
    if (!scroller || !nav) return;
    var cal = scroller.querySelector('.cal');
    var label = scroller.querySelector('.cal-label');
    var todayLine = scroller.querySelector('.cal-today');
    var todayBtn = nav.querySelector('[data-cal-nav="today"]');
    var focused = false;

    function labelWidth() { return label ? label.getBoundingClientRect().width : 0; }
    function viewWidth() { return scroller.clientWidth - labelWidth(); } // visible track
    function overflowing() { return scroller.scrollWidth > scroller.clientWidth + 1; }
    function scrollTo(left, smooth) {
      left = Math.max(0, left);
      if (smooth && 'scrollBehavior' in document.documentElement.style) {
        scroller.scrollTo({ left: left, behavior: 'smooth' });
      } else {
        scroller.scrollLeft = left;
      }
    }
    // Today sits about 40% across the visible track.
    function goToday(smooth) {
      if (!todayLine) return;
      var x = todayLine.getBoundingClientRect().left - cal.getBoundingClientRect().left;
      scrollTo(x - labelWidth() - viewWidth() * 0.4, smooth);
    }
    function page(dir) { scrollTo(scroller.scrollLeft + dir * viewWidth() * 0.8, true); }
    function update() {
      var on = overflowing();
      nav.classList.toggle('is-on', on);
      scroller.classList.toggle('cal-scrolled', scroller.scrollLeft > 2);
      if (on && !focused) { focused = true; goToday(false); }
    }

    if (!todayLine && todayBtn) todayBtn.hidden = true;
    nav.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-cal-nav]');
      if (!btn) return;
      var which = btn.getAttribute('data-cal-nav');
      if (which === 'back') page(-1);
      else if (which === 'fwd') page(1);
      else goToday(true);
    });
    scroller.addEventListener('scroll', function () {
      scroller.classList.toggle('cal-scrolled', scroller.scrollLeft > 2);
    }, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

<%- include("partials/footer") %>
